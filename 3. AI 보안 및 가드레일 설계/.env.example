######################
# LLM API Key
######################
# 모듈 1, 2는 실제 LLM으로 A/B 테스트를 실행합니다.
# OpenAI 또는 Groq 중 하나 이상을 채우세요.
OPENAI_API_KEY=""
GROQ_API_KEY=""

######################
# LangSmith
######################
# Agent 보안 실험 로그와 A/B 테스트 실행 기록을 추적할 때 사용합니다.
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_PROJECT="AI Security Guardrails TUTORIAL"
LANGCHAIN_API_KEY=""

######################
# Tools
######################
# 모듈 1은 실제 TavilySearch 결과를 사용합니다.
TAVILY_API_KEY=""

######################
# SQL Demo
######################
# 모듈 4에서 사용하는 SQLite 데모 DB 파일 경로입니다.
SECURITY_DEMO_SQLITE_PATH="security_demo.sqlite"

######################
# Lecture Demo
######################
# 수업용 가짜 비밀값입니다. 실제 운영 키를 넣지 마세요.
DEMO_API_KEY="demo-lecture-only"
