######################
# LLM API Key
######################
# 기본 보안 실습 노트북은 실제 API Key 없이 실행되도록 구성되어 있습니다.
# 실제 LLM 기반 실습으로 확장할 때만 아래 값을 채우세요.
OPENAI_API_KEY=""
GROQ_API_KEY=""

######################
# LangSmith
######################
# Agent 보안 실험 로그와 A/B 테스트 실행 기록을 추적할 때 사용합니다.
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_PROJECT="AI Security Guardrails TUTORIAL"
LANGCHAIN_API_KEY=""

######################
# Tools
######################
# Prompt Injection 실습을 실제 검색 Tool로 확장할 때 사용합니다.
TAVILY_API_KEY=""

######################
# Lecture Demo
######################
# 수업용 가짜 비밀값입니다. 실제 운영 키를 넣지 마세요.
DEMO_API_KEY="demo-lecture-only"

